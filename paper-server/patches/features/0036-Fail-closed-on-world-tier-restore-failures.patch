From 80511642c556b00727b3ba2cf1a296a1754d32a4 Mon Sep 17 00:00:00 2001
From: FiestaSMP Engineering <noreply@github.com>
Date: Thu, 19 Nov 2026 07:15:51 +0530
Subject: [PATCH] Fail closed on world tier restore failures

---
 .../scheduling/task/ChunkLoadTask.java        | 29 ++++++++++++++++++++++++++++-
 .../chunk/storage/RegionFileStorage.java      | 23 ++++++++++++++++++------
 2 files changed, 45 insertions(+), 7 deletions(-)

diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/task/ChunkLoadTask.java b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/task/ChunkLoadTask.java
index 7463cf5..60c31da 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/task/ChunkLoadTask.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/task/ChunkLoadTask.java
@@ -19,6 +19,7 @@ import net.minecraft.world.level.chunk.ChunkAccess;
 import net.minecraft.world.level.chunk.ProtoChunk;
 import net.minecraft.world.level.chunk.UpgradeData;
 import net.minecraft.world.level.chunk.status.ChunkStatus;
+import net.minecraft.world.level.chunk.storage.FiestaWorldTierRestoreException;
 import net.minecraft.world.level.chunk.storage.SerializableChunkData;
 import net.minecraft.world.level.levelgen.blending.BlendingData;
 import org.slf4j.Logger;
@@ -36,6 +37,7 @@ public final class ChunkLoadTask extends ChunkProgressionTask {
     private final ChunkDataLoadTask loadTask;
 
     private volatile boolean cancelled;
+    private volatile FiestaWorldTierRestoreException tierRestoreFailure;
     private NewChunkHolder.GenericDataLoadTaskCallback entityLoadTask;
     private NewChunkHolder.GenericDataLoadTaskCallback poiLoadTask;
     private GenericDataLoadTask.TaskResult<ChunkAccess, Throwable> loadResult;
@@ -48,15 +50,30 @@ public final class ChunkLoadTask extends ChunkProgressionTask {
         this.loadTask = new ChunkDataLoadTask(scheduler, world, chunkX, chunkZ, priority);
         this.loadTask.addCallback((final GenericDataLoadTask.TaskResult<ChunkAccess, Throwable> result) -> {
             ChunkLoadTask.this.loadResult = result; // must be before getAndDecrement
+            ChunkLoadTask.this.recordTierRestoreFailure(result == null ? null : result.right());
             ChunkLoadTask.this.tryCompleteLoad();
         });
     }
 
+    private void recordTierRestoreFailure(final Object possibleFailure) {
+        if (!(possibleFailure instanceof Throwable throwable)) {
+            return;
+        }
+        final FiestaWorldTierRestoreException failure = FiestaWorldTierRestoreException.find(throwable);
+        if (failure != null) {
+            this.tierRestoreFailure = failure;
+        }
+    }
+
     private void tryCompleteLoad() {
         final int count = this.taskCountToComplete.decrementAndGet();
         if (count == 0) {
             final GenericDataLoadTask.TaskResult<ChunkAccess, Throwable> result = this.cancelled ? null : this.loadResult; // only after the getAndDecrement
-            ChunkLoadTask.this.complete(result == null ? null : result.left(), result == null ? null : result.right());
+            final FiestaWorldTierRestoreException tierFailure = this.tierRestoreFailure;
+            ChunkLoadTask.this.complete(
+                result == null ? null : result.left(),
+                tierFailure != null ? tierFailure : result == null ? null : result.right()
+            );
         } else if (count < 0) {
             throw new IllegalStateException("Called tryCompleteLoad() too many times");
         }
@@ -80,6 +97,7 @@ public final class ChunkLoadTask extends ChunkProgressionTask {
         final NewChunkHolder.GenericDataLoadTaskCallback poiLoadTask;
 
         final Consumer<GenericDataLoadTask.TaskResult<?, ?>> scheduleLoadTask = (final GenericDataLoadTask.TaskResult<?, ?> result) -> {
+            ChunkLoadTask.this.recordTierRestoreFailure(result == null ? null : result.right());
             ChunkLoadTask.this.tryCompleteLoad();
         };
 
@@ -331,6 +349,9 @@ public final class ChunkLoadTask extends ChunkProgressionTask {
         protected TaskResult<ReadChunk, Throwable> runOffMain(final CompoundTag data, final Throwable throwable) {
             if (throwable != null) {
                 LOGGER.error("Failed to load chunk data for task: " + this.toString() + ", chunk data will be lost", throwable);
+                if (FiestaWorldTierRestoreException.find(throwable) != null) {
+                    return new TaskResult<>(null, throwable);
+                }
                 return new TaskResult<>(null, null);
             }
 
@@ -408,6 +429,9 @@ public final class ChunkLoadTask extends ChunkProgressionTask {
         protected TaskResult<PoiChunk, Throwable> runOffMain(final CompoundTag data, final Throwable throwable) {
             if (throwable != null) {
                 LOGGER.error("Failed to load poi data for task: " + this.toString() + ", poi data will be lost", throwable);
+                if (FiestaWorldTierRestoreException.find(throwable) != null) {
+                    return new TaskResult<>(null, throwable);
+                }
                 return new TaskResult<>(PoiChunk.empty(this.world, this.chunkX, this.chunkZ), null);
             }
 
@@ -470,6 +494,9 @@ public final class ChunkLoadTask extends ChunkProgressionTask {
         protected TaskResult<CompoundTag, Throwable> runOffMain(final CompoundTag data, final Throwable throwable) {
             if (throwable != null) {
                 LOGGER.error("Failed to load entity data for task: " + this.toString() + ", entity data will be lost", throwable);
+                if (FiestaWorldTierRestoreException.find(throwable) != null) {
+                    return new TaskResult<>(null, throwable);
+                }
                 return new TaskResult<>(null, null);
             }
 
diff --git a/net/minecraft/world/level/chunk/storage/RegionFileStorage.java b/net/minecraft/world/level/chunk/storage/RegionFileStorage.java
index 376ff223194689b0f359b653744414269daa8e97..eda8434befd697a78d3d3c02854aa8953202b051 100644
--- a/net/minecraft/world/level/chunk/storage/RegionFileStorage.java
+++ b/net/minecraft/world/level/chunk/storage/RegionFileStorage.java
@@ -109,12 +109,16 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
         if (restoreRequired) {
             final RegionFile stale = this.regionCache.remove(key);
             if (stale != null) {
-                stale.close();
+                try {
+                    stale.close();
+                } catch (final IOException ex) {
+                    throw new FiestaWorldTierRestoreException("Could not close cached region before Fiesta recovery", ex);
+                }
             }
             if (!FiestaRegionRestorer.restoreIfMarked(
                 this.folder, this.info.dimension().identifier().toString(), chunkX, chunkZ
             )) {
-                throw new IOException("Marked Fiesta world-tier region was not restored before cache lookup");
+                throw new FiestaWorldTierRestoreException("Marked Fiesta world-tier region was not restored before cache lookup", null);
             }
             this.createRegionFile(key);
         }
@@ -136,7 +140,7 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
 
         if (!java.nio.file.Files.exists(regionPath)) {
             if (restoreRequired && this.folder.getFileName().toString().equals("region")) {
-                throw new IOException("Restored Fiesta world-tier terrain region is missing: " + regionPath);
+                throw new FiestaWorldTierRestoreException("Restored Fiesta world-tier terrain region is missing: " + regionPath, null);
             }
             this.markNonExisting(key);
             return null;
@@ -309,13 +313,17 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
             if (restoreRequired) {
                 final RegionFile stale = this.regionCache.remove(key);
                 if (stale != null) {
-                    stale.close();
+                    try {
+                        stale.close();
+                    } catch (final IOException ex) {
+                        throw new FiestaWorldTierRestoreException("Could not close cached region before Fiesta recovery", ex);
+                    }
                 }
                 if (!FiestaRegionRestorer.restoreIfMarked(
                     this.folder, this.info.dimension().identifier().toString(), chunkPos.x, chunkPos.z
                 )) {
-                    throw new IOException("Marked Fiesta world-tier region was not restored before write: "
-                        + this.folder.resolve(getRegionFileName(chunkPos.x, chunkPos.z)));
+                    throw new FiestaWorldTierRestoreException("Marked Fiesta world-tier region was not restored before write: "
+                        + this.folder.resolve(getRegionFileName(chunkPos.x, chunkPos.z)), null);
                 }
                 this.createRegionFile(key);
             }
@@ -331,6 +339,9 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
 
             final Path regionPath = this.folder.resolve(getRegionFileName(chunkPos.x, chunkPos.z));
 
+            if (restoreRequired && this.folder.getFileName().toString().equals("region") && !java.nio.file.Files.exists(regionPath)) {
+                throw new FiestaWorldTierRestoreException("Restored Fiesta world-tier terrain region is missing before write: " + regionPath, null);
+            }
             FiestaRegionRestorer.invalidate(this.folder, chunkPos.x, chunkPos.z);
             this.createRegionFile(key);
             FiestaRegionRestorer.invalidate(this.folder, chunkPos.x, chunkPos.z); // Fiesta - clear cached journal state

