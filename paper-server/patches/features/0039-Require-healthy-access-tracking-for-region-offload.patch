From ea6e05af95a72496be481ca62ba843fc9672c687 Mon Sep 17 00:00:00 2001
From: FiestaSMP Engineering <noreply@github.com>
Date: Thu, 19 Nov 2026 09:28:40 +0530
Subject: [PATCH] Require healthy access tracking before offload

---
 .../moonrise/patches/chunk_system/io/MoonriseRegionFileIO.java | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/io/MoonriseRegionFileIO.java b/ca/spottedleaf/moonrise/patches/chunk_system/io/MoonriseRegionFileIO.java
index 03a4985..9dab895 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/io/MoonriseRegionFileIO.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/io/MoonriseRegionFileIO.java
@@ -172,6 +172,9 @@ public final class MoonriseRegionFileIO {
             TIERING_EXECUTOR.execute(() -> {
                 try {
                     try (final RegionTieringLease lease = acquireTieringLease(world, regionX, regionZ).join()) {
+                        if (!FiestaRegionAccessTracker.isTrackingHealthy(dimensionRoot)) {
+                            throw new IllegalStateException("Region access tracking is unhealthy; refusing offload");
+                        }
                         net.minecraft.world.level.chunk.storage.FiestaRegionOffloader.offload(
                             dimensionRoot, world.dimension().identifier().toString(), regionX, regionZ
                         );
