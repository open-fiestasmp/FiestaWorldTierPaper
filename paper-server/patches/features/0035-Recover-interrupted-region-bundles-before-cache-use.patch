From 6ace9c84d72b877cbb4432a44953ee672d2f9d70 Mon Sep 17 00:00:00 2001
From: FiestaSMP Engineering <noreply@github.com>
Date: Wed, 25 Nov 2026 08:55:32 +0530
Subject: [PATCH] Recover interrupted region bundles before cache use

---
 .../chunk/storage/RegionFileStorage.java      | 48 +++++++++++++------
 1 file changed, 33 insertions(+), 15 deletions(-)

diff --git a/net/minecraft/world/level/chunk/storage/RegionFileStorage.java b/net/minecraft/world/level/chunk/storage/RegionFileStorage.java
index a20469532aecc0d8c8124347490df6c2b4c04e49..376ff223194689b0f359b653744414269daa8e97 100644
--- a/net/minecraft/world/level/chunk/storage/RegionFileStorage.java
+++ b/net/minecraft/world/level/chunk/storage/RegionFileStorage.java
@@ -103,12 +103,27 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
     public synchronized final RegionFile moonrise$getRegionFileIfExists(final int chunkX, final int chunkZ) throws IOException {
         final long key = ChunkPos.asLong(chunkX >> REGION_SHIFT, chunkZ >> REGION_SHIFT);
 
+        final boolean restoreRequired = FiestaRegionRestorer.needsRestore(
+            this.folder, this.info.dimension().identifier().toString(), chunkX, chunkZ
+        ); // Fiesta - remote region restore
+        if (restoreRequired) {
+            final RegionFile stale = this.regionCache.remove(key);
+            if (stale != null) {
+                stale.close();
+            }
+            if (!FiestaRegionRestorer.restoreIfMarked(
+                this.folder, this.info.dimension().identifier().toString(), chunkX, chunkZ
+            )) {
+                throw new IOException("Marked Fiesta world-tier region was not restored before cache lookup");
+            }
+            this.createRegionFile(key);
+        }
+
         RegionFile ret = this.regionCache.getAndMoveToFirst(key);
         if (ret != null) {
             return ret;
         }
 
-        final boolean restoreRequired = FiestaRegionRestorer.needsRestore(this.folder, this.info.dimension().identifier().toString(), chunkX, chunkZ); // Fiesta - remote region restore
         if (!restoreRequired && !this.doesRegionFilePossiblyExist(key)) {
             return null;
         }
@@ -119,11 +134,6 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
 
         final Path regionPath = this.folder.resolve(getRegionFileName(chunkX, chunkZ));
 
-        if (restoreRequired && !FiestaRegionRestorer.restoreIfMarked(
-            this.folder, this.info.dimension().identifier().toString(), chunkX, chunkZ
-        )) { // Fiesta - remote region restore
-            throw new IOException("Marked Fiesta world-tier region was not restored: " + regionPath);
-        }
         if (!java.nio.file.Files.exists(regionPath)) {
             if (restoreRequired && this.folder.getFileName().toString().equals("region")) {
                 throw new IOException("Restored Fiesta world-tier terrain region is missing: " + regionPath);
@@ -293,6 +303,23 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
         synchronized (this) {
             final long key = ChunkPos.asLong(chunkPos.x >> REGION_SHIFT, chunkPos.z >> REGION_SHIFT);
 
+            final boolean restoreRequired = FiestaRegionRestorer.needsRestore(
+                this.folder, this.info.dimension().identifier().toString(), chunkPos.x, chunkPos.z
+            );
+            if (restoreRequired) {
+                final RegionFile stale = this.regionCache.remove(key);
+                if (stale != null) {
+                    stale.close();
+                }
+                if (!FiestaRegionRestorer.restoreIfMarked(
+                    this.folder, this.info.dimension().identifier().toString(), chunkPos.x, chunkPos.z
+                )) {
+                    throw new IOException("Marked Fiesta world-tier region was not restored before write: "
+                        + this.folder.resolve(getRegionFileName(chunkPos.x, chunkPos.z)));
+                }
+                this.createRegionFile(key);
+            }
+
             RegionFile ret = this.regionCache.getAndMoveToFirst(key);
             if (ret != null) {
                 return ret;
@@ -307,12 +334,3 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
-            final boolean restoreRequired = FiestaRegionRestorer.needsRestore(this.folder, this.info.dimension().identifier().toString(), chunkPos.x, chunkPos.z);
-            if (restoreRequired) {
-                if (!FiestaRegionRestorer.restoreIfMarked(this.folder, this.info.dimension().identifier().toString(), chunkPos.x, chunkPos.z)) {
-                    throw new IOException("Marked Fiesta world-tier region was not restored before write: " + regionPath);
-                }
-                if (this.folder.getFileName().toString().equals("region") && !java.nio.file.Files.exists(regionPath)) {
-                    throw new IOException("Restored Fiesta world-tier terrain region is missing before write: " + regionPath);
-                }
-            }
-
+            FiestaRegionRestorer.invalidate(this.folder, chunkPos.x, chunkPos.z);
             this.createRegionFile(key);
             FiestaRegionRestorer.invalidate(this.folder, chunkPos.x, chunkPos.z); // Fiesta - clear cached journal state
