+    /**
+     * Offloads one region on a dedicated worker while holding Paper's exclusive
+     * region lease for the child process's full upload and local eviction.
+     */
+    public static CompletableFuture<Void> offloadRegion(final ServerLevel world, final int regionX, final int regionZ) {
+        final Path regionFolder = ((ChunkSystemRegionFileStorage)getControllerFor(world, RegionFileType.CHUNK_DATA)
+            .getCache()).moonrise$getRegionFolder();
+        final Path dimensionRoot = regionFolder.getParent();
+        if (dimensionRoot == null) {
+            return CompletableFuture.failedFuture(new IllegalStateException("Region folder has no dimension root: " + regionFolder));
+        }
+        final String operationKey = dimensionRoot.toAbsolutePath().normalize() + ":" + regionX + ":" + regionZ;
+        if (!PENDING_TIERING.add(operationKey)) {
+            return CompletableFuture.failedFuture(new IllegalStateException("Region tier operation is already pending"));
+        }
+
+        final CompletableFuture<Void> result = new CompletableFuture<>();
+        try {
+            TIERING_EXECUTOR.execute(() -> {
+                try {
+                    try (final RegionTieringLease lease = acquireTieringLease(world, regionX, regionZ).join()) {
+                        net.minecraft.world.level.chunk.storage.FiestaRegionOffloader.offload(
+                            dimensionRoot, world.dimension().identifier().toString(), regionX, regionZ
+                        );
+                    }
+                    result.complete(null);
+                } catch (final Throwable thr) {
+                    final Throwable cause = thr instanceof CompletionException && thr.getCause() != null ? thr.getCause() : thr;
+                    result.completeExceptionally(cause);
+                } finally {
+                    PENDING_TIERING.remove(operationKey);
+                }
+            });
+        } catch (final Throwable thr) {
+            PENDING_TIERING.remove(operationKey);
+            result.completeExceptionally(thr);
+        }
+        return result;
+    }
+
     public static final class RegionTieringLease implements AutoCloseable {
         private final FiestaRegionLeaseManager.Lease lease;
+        private final FiestaRegionLeaseManager.ProcessLease processLease;
 
-        private RegionTieringLease(final FiestaRegionLeaseManager.Lease lease) {
+        private RegionTieringLease(final FiestaRegionLeaseManager.Lease lease,
+                                   final FiestaRegionLeaseManager.ProcessLease processLease) {
             this.lease = lease;
+            this.processLease = processLease;
         }
 
         @Override
         public void close() {
-            this.lease.close();
+            try {
+                this.processLease.close();
+            } catch (final IOException ex) {
+                LOGGER.error("Could not release Fiesta region process lease", ex);
+            } finally {
+                this.lease.close();
+            }
         }
     }
 
