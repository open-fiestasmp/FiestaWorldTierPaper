+    /**
+     * Checks whether a full 32 by 32 Anvil region has no chunk holders or
+     * tickets. The region's ticket and scheduling locks make the scan
+     * consistent with concurrent holder creation and ticket updates.
+     */
+    public boolean isRegionUnloadedForTiering(final int regionX, final int regionZ) {
+        TickThread.ensureTickThread("Cannot inspect region tiering eligibility off-main");
+
+        final int minChunkX = regionX << 5;
+        final int minChunkZ = regionZ << 5;
+        final int maxChunkX = minChunkX + 31;
+        final int maxChunkZ = minChunkZ + 31;
+        final ReentrantAreaLock.Node ticketLock = this.ticketLockArea.lock(minChunkX, minChunkZ, maxChunkX, maxChunkZ);
+        try {
+            final ReentrantAreaLock.Node scheduleLock = this.taskScheduler.schedulingLockArea.lock(minChunkX, minChunkZ, maxChunkX, maxChunkZ);
+            try {
+                for (int chunkX = minChunkX; chunkX <= maxChunkX; ++chunkX) {
+                    for (int chunkZ = minChunkZ; chunkZ <= maxChunkZ; ++chunkZ) {
+                        final long chunkKey = CoordinateUtils.getChunkKey(chunkX, chunkZ);
+                        if (this.chunkHolders.get(chunkKey) != null || this.tickets.get(chunkKey) != null) {
+                            return false;
+                        }
+                    }
+                }
+                return true;
+            } finally {
+                this.taskScheduler.schedulingLockArea.unlock(scheduleLock);
+            }
+        } finally {
+            this.ticketLockArea.unlock(ticketLock);
+        }
+    }
