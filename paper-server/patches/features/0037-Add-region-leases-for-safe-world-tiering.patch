+    /**
+     * Acquires an exclusive lease for an unloaded Anvil region and closes its
+     * cached terrain, entity, and POI files. The returned lease must remain
+     * open until the caller has finished the tier operation.
+     */
+    public static CompletableFuture<RegionTieringLease> acquireTieringLease(final ServerLevel world,
+                                                                            final int regionX, final int regionZ) {
+        final RegionDataController terrain = getControllerFor(world, RegionFileType.CHUNK_DATA);
+        final Path regionFolder = ((ChunkSystemRegionFileStorage)terrain.getCache()).moonrise$getRegionFolder();
+        final Path dimensionRoot = regionFolder.getParent();
+        if (dimensionRoot == null) {
+            return CompletableFuture.failedFuture(new IllegalStateException("Region folder has no dimension root: " + regionFolder));
+        }
+
+        final RegionDataController[] controllers = new RegionDataController[] {
+            terrain,
+            getControllerFor(world, RegionFileType.ENTITY_DATA),
+            getControllerFor(world, RegionFileType.POI_DATA)
+        };
+        for (final RegionDataController controller : controllers) {
+            final Path controllerFolder = ((ChunkSystemRegionFileStorage)controller.getCache()).moonrise$getRegionFolder();
+            if (!dimensionRoot.equals(controllerFolder.getParent())) {
+                return CompletableFuture.failedFuture(new IllegalStateException(
+                    "Terrain, entity, and POI region folders do not share a dimension root"
+                ));
+            }
+        }
+
+        final CompletableFuture<RegionTieringLease> result = new CompletableFuture<>();
+        FiestaRegionLeaseManager.acquireExclusive(dimensionRoot, regionX, regionZ).whenComplete((lease, acquireFailure) -> {
+            if (acquireFailure != null) {
+                result.completeExceptionally(acquireFailure);
+                return;
+            }
+            if (result.isCancelled()) {
+                lease.close();
+                return;
+            }
+            try {
+                world.getServer().execute(() -> {
+                    if (result.isCancelled()) {
+                        lease.close();
+                        return;
+                    }
+                    try {
+                        final ChunkSystemServerLevel moonriseWorld = (ChunkSystemServerLevel)world;
+                        if (!moonriseWorld.moonrise$getChunkTaskScheduler().chunkHolderManager
+                            .isRegionUnloadedForTiering(regionX, regionZ)) {
+                            throw new IllegalStateException("Region still has chunk holders and cannot be tiered");
+                        }
+
+                        for (final RegionDataController controller : controllers) {
+                            ((ChunkSystemRegionFileStorage)controller.getCache())
+                                .moonrise$closeRegionForTiering(regionX, regionZ);
+                        }
+                        final RegionTieringLease tieringLease = new RegionTieringLease(lease);
+                        if (!result.complete(tieringLease)) {
+                            tieringLease.close();
+                        }
+                    } catch (final Throwable thr) {
+                        lease.close();
+                        result.completeExceptionally(thr);
+                    }
+                });
+            } catch (final Throwable thr) {
+                lease.close();
+                result.completeExceptionally(thr);
+            }
+        });
+        return result;
+    }
+
+    public static final class RegionTieringLease implements AutoCloseable {
+        private final FiestaRegionLeaseManager.Lease lease;
+
+        private RegionTieringLease(final FiestaRegionLeaseManager.Lease lease) {
+            this.lease = lease;
+        }
+
+        @Override
+        public void close() {
+            this.lease.close();
+        }
+    }
