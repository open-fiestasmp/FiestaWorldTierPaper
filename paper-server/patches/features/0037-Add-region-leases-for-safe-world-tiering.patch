-        final void startTask(final ChunkIOTask task) {
+        final void startTask(final ChunkIOTask task, final Runnable schedule) {
+            final java.nio.file.Path folder = ((ChunkSystemRegionFileStorage)this.getCache()).moonrise$getRegionFolder();
+            final java.nio.file.Path dimensionRoot = folder.getParent();
+            if (dimensionRoot == null) {
+                throw new IllegalStateException("Region folder has no dimension root: " + folder);
+            }
             this.inProgressTasks.getAndIncrement();
+            FiestaRegionLeaseManager.acquireShared(dimensionRoot, task.chunkX >> 5, task.chunkZ >> 5).whenComplete((lease, throwable) -> {
+                if (throwable != null) {
+                    this.inProgressTasks.getAndDecrement();
+                    LOGGER.error("Failed to acquire shared Fiesta region lease for task " + task, throwable);
+                    task.failStart(throwable);
+                    return;
+                }
+                task.setRegionLease(lease);
+                try {
+                    schedule.run();
+                } catch (final Throwable thr) {
+                    task.releaseRegionLease();
+                    this.inProgressTasks.getAndDecrement();
+                    LOGGER.error("Failed to schedule task after acquiring Fiesta region lease: " + task, thr);
+                    task.failStart(thr);
+                }
+            });
         }
 
         final void endTask(final ChunkIOTask task) {
+            task.releaseRegionLease();
             this.inProgressTasks.getAndDecrement();
         }
 
